# Copy this file to .env and replace the password with a unique strong secret.
DB_PASSWORD=replace-with-a-unique-strong-password

# Optional resource and host settings.
APP_UID=1000
APP_GID=1000
MSSQL_MEMORY_LIMIT_MB=1536
SQL_CONTAINER_MEMORY=2g
SQL_HOST_PORT=1433
JUPYTER_HOST_PORT=8888
N_REGISTROS=100000
SEMILLA=1800
